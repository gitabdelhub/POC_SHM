# Copiez ce fichier en "api/.env" (exclu de git) et remplissez les valeurs.
# Sur Vercel, déclarez les mêmes variables dans Settings > Environment Variables.

# Adresse de la base Neon, telle que copiée depuis le tableau de bord Neon
# (Connection string). Le code la convertit automatiquement pour le pilote pg8000.
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE.neon.tech/neondb?sslmode=require

# Clé qui signe les jetons de connexion : une longue chaîne aléatoire.
# Pour en générer une : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Assistant IA : clé gratuite sur https://console.groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
