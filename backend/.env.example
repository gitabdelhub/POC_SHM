# Copier ce fichier vers `.env` puis renseigner les valeurs.
# Configuration requise par `backend/app/config.py` (pydantic-settings).

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/saham_bank
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=saham_bank
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# OAuth 2.0 + PKCE (placeholders pour le moment)
SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
OAUTH_CLIENT_ID=client_id
OAUTH_CLIENT_SECRET=client_secret
OAUTH_REDIRECT_URI=http://localhost:3000/callback

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# RAG / Chatbot IA
LLM_PROVIDER=groq                # "groq" | "ollama" | "mock"
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
AI_TOP_K=4
SQL_MAX_ROWS=100

# CORS (origines autorisees, separees par des virgules)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000